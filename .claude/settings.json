{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run dev *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run dev *)",
      "PowerShell(npm test *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx playwright test *)",
      "PowerShell(npx prisma generate *)",
      "PowerShell(npx prisma migrate dev *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr create *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(npx prisma migrate reset *)",
      "PowerShell(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(npx prisma migrate reset *)"
    ]
  }
}
